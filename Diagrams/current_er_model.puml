@startuml
left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam linetype ortho
skinparam ArrowColor #2F5597
skinparam nodesep 55
skinparam ranksep 70

skinparam entity {
  BackgroundColor #F8FBFF
  BorderColor #2F5597
  FontColor #333333
}

skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #A6A6A6
  FontStyle bold
}

skinparam note {
  BackgroundColor #FFF8D7
  BorderColor #C9B458
}

hide circle

' =====================================================
' 1. КОНФИГУРАЦИЯ И ЗАПУСК
' =====================================================

package "1. Конфигурация\nи запуск" as P_CONFIG {

  entity "GasFilter\nГазовый фильтр" as Filter {
    * filter_id
    --
    q_nominal
    p_in_nominal
    dp0
    dp_warn
    dp_crit
  }

  entity "ScenarioConfig\nКонфигурация сценария" as Config {
    * scenario_name
    --
    duration_days
    step_minutes
    seed
    degradation_params
    sensor_fault_params
    rul_thresholds
  }

  entity "SimulationRun\nПрогон симуляции" as Run {
    * run_id
    --
    started_at
    config_hash
    rows_count
  }

  Filter ||--o{ Run : используется\nв прогоне
  Config ||--o{ Run : задает\nусловия
}

' =====================================================
' 2. ВРЕМЕННОЙ РЯД СИМУЛЯТОРА
' =====================================================

package "2. Временной ряд\nсимулятора" as P_SERIES {

  entity "TelemetrySnapshot\nНаблюдаемая телеметрия" as Telemetry {
    * run_id
    * timestamp
    --
    p_in
    p_out
    delta_p
    q
    t
    quality_code
    spike_event
    state_obs
  }

  entity "TruthState\nСкрытое состояние" as Truth {
    * run_id
    * timestamp
    --
    q_true
    p_in_true
    p_out_true
    delta_p_true
    resistance_factor
    clog_level
    rul_oracle
    is_rul_unknown
  }

  entity "QualityReport\nОтчет качества" as QC {
    * run_id
    --
    rows_total
    rows_with_issues
    quality_counts
    pressure_order_ok
    nonnegative_dp_ok
    nonnegative_q_ok
  }

  Run ||--o{ Telemetry : формирует\nнаблюдения
  Run ||--o{ Truth : формирует\nскрытую истину
  Run ||--|| QC : проверяется
  Telemetry ||--|| Truth : соответствует\nтой же точке времени
}

' =====================================================
' 3. ДАТАСЕТ И ПРИЗНАКИ
' =====================================================

package "3. Датасет\nи признаки" as P_FEATURES {

  entity "CanonicalDatasetRow\nСтрока датасета" as Dataset {
    * run_id
    * timestamp
    --
    observed_channels
    passport_params
    degradation_params
    deltaP_norm
    state
    RUL_oracle
    RUL_analytic
    quality_code
  }

  entity "DiagnosticFeatureSet\nДиагностические признаки" as Features {
    * run_id
    * timestamp
    --
    deltaP_roll_mean_1h
    deltaP_roll_std_1h
    deltaP_slope_6h
    deltaP_roll_mean_24h
    deltaP_slope_24h
    deltaP_slope_72h
    Q_roll_mean_1h
    missing_rate_1h
    time_above_warn
    elapsed_hours
    cumulative_load_h
  }

  Telemetry ||--|| Dataset : входит\nв датасет
  Truth ||--|| Dataset : добавляет\nцелевые поля
  Dataset ||--o| Features : преобразуется\nв признаки
}

' =====================================================
' 4. ПРОГНОЗИРОВАНИЕ RUL
' =====================================================

package "4. Прогнозирование\nRUL" as P_PREDICTION {

  entity "AnalyticRUL\nАналитический прогноз" as Analytic {
    * run_id
    * timestamp
    --
    RUL_analytic
    state_rule
    threshold_logic
  }

  entity "MLTrainingCorpus\nКорпус обучения ML" as Corpus {
    * corpus_id
    --
    generated_runs
    train_run_ids
    test_run_ids
    split_type
  }

  entity "MLModel\nML-модель RUL" as MLModel {
    * model_name
    --
    model_type
    target
    input_columns
    trained_at
    metrics
    artifact
  }

  entity "MLPrediction\nML-прогноз RUL" as MLPrediction {
    * run_id
    * timestamp
    --
    split
    RUL_pred
    RUL_oracle
  }

  entity "ModelQuality\nКачество модели" as ModelQuality {
    * model_name
    * evaluation_scope
    --
    mae
    rmse
    r2
    by_run_id
    by_scenario
    analytic_comparison
  }

  Dataset ||--o{ Corpus : используется\nдля обучения
  Features ||--o{ Corpus : входит\nв ML-входы
  Corpus ||--|| MLModel : обучает
  MLModel ||--o{ MLPrediction : строит\nпрогноз
  Dataset ||--o| Analytic : дает\nаналитику
  Dataset ||--o| MLPrediction : точка\ninference
  Features ||--o| MLPrediction : признаки\ninference
  MLModel ||--o{ ModelQuality : оценивается
}

' =====================================================
' 5. ГИБРИДНЫЙ СЛОЙ И ЭКСПЛУАТАЦИОННЫЕ СОБЫТИЯ
' =====================================================

package "5. Гибридный слой\nи события" as P_HYBRID {

  entity "HybridDecision\nИтоговый RUL" as Hybrid {
    * run_id
    * timestamp
    --
    RUL_fused
    rul_source
    confidence_data
    confidence_model
    confidence_consistency
    confidence_total
  }

  entity "MaintenanceEvent\nСобытие обслуживания" as Maintenance {
    * run_id
    * event_type
    --
    detected_at
    threshold_rul
    source
    stable_window
  }

  Analytic ||--o| Hybrid : источник\nRUL_analytic
  MLPrediction ||--o| Hybrid : источник\nRUL_ml
  Dataset ||--o| Hybrid : качество\nи состояние
  Features ||--o| Hybrid : признаки\nдоверия
  Hybrid ||--o{ Maintenance : пересекает\nRUL-пороги
}

' =====================================================
' ГЛАВНЫЙ ПОТОК ДАННЫХ
' =====================================================

P_CONFIG -[hidden]right-> P_SERIES
P_SERIES -[hidden]right-> P_FEATURES
P_FEATURES -[hidden]right-> P_PREDICTION
P_PREDICTION -[hidden]right-> P_HYBRID

note top of Run
  Прогон является центральным контекстом:
  все временные точки, признаки, прогнозы
  и оценки качества относятся к run_id.
end note

note top of Dataset
  Строка датасета объединяет наблюдаемую
  телеметрию, паспортные параметры фильтра,
  скрытую истину симулятора и аналитический RUL.

  Скрытые/целевые поля используются для оценки,
  но не подаются на вход ML-модели.
end note

note top of MLModel
  ML-модель обучается отдельно на корпусе
  независимых прогонов и затем переиспользуется
  для inference текущего запуска.
end note

note top of Hybrid
  Гибридный слой выбирает итоговый RUL:
  ML-прогноз, консервативный минимум или
  аналитический fallback с учетом доверия
  к данным, модели и согласованности.
end note

@enduml
